# URL pública del backend (API). En local, la API de Express corriendo en el puerto 4000.
NEXT_PUBLIC_API_URL=http://localhost:4000

# URL pública del propio frontend (para metadata, sitemap, robots, JSON-LD, canonical, OG, etc.)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Código de verificación de Google Search Console (opcional, alternativa al archivo HTML)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
