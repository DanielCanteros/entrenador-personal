# Puerto donde escucha la API
PORT=4000
NODE_ENV=development

# URL pública de esta API (se usa para construir las URLs de las imágenes subidas)
BASE_URL=http://localhost:4000

# URL del frontend permitida por CORS (en producción, tu dominio de Vercel/propio)
FRONTEND_URL=http://localhost:3000

# URL completa del endpoint de revalidación del frontend (Next.js) y secreto
# compartido: se usan para avisarle al frontend que invalide su caché de
# posts en cuanto el admin crea/edita/borra/traduce un artículo, en vez de
# esperar a que expire por tiempo. Deben coincidir con REVALIDATE_SECRET en
# frontend/.env.local. Si se dejan vacíos, el aviso simplemente se omite.
REVALIDATE_URL=http://localhost:3000/api/revalidate
REVALIDATE_SECRET=cambia-este-valor-por-un-secreto-largo-y-aleatorio

# Cadena de conexión de MongoDB. Recomendado: clúster gratuito M0 de MongoDB Atlas.
# Ejemplo Atlas: mongodb+srv://usuario:password@cluster0.xxxxx.mongodb.net/entrenador-personal
MONGODB_URI=mongodb://127.0.0.1:27017/entrenador-personal

# Secreto para firmar los JWT del panel de administración (usa una cadena larga y aleatoria)
JWT_SECRET=cambia-este-valor-por-un-secreto-largo-y-aleatorio
JWT_EXPIRES_IN=7d

# Credenciales del usuario administrador que crea el script scripts/seedAdmin.js
ADMIN_EMAIL=admin@tudominio.com
ADMIN_PASSWORD=cambia-esta-password
ADMIN_NAME="Administrador"

# Brevo (ex-Sendinblue): usado para invitar clientes a completar su registro
# (ver routes/clientes.routes.js) mandando la plantilla de Brevo llamada
# "inscripcion" (Campañas > Plantillas > Email). La API key se genera en
# Brevo > Configuración > Claves SMTP y API. BREVO_TEMPLATE_ID_INSCRIPCION es
# el ID numérico de esa plantilla (aparece como "#<id>" en el listado).
# BREVO_SENDER_EMAIL/NAME son opcionales: si se dejan vacíos, se usa el
# remitente ya configurado dentro de la propia plantilla en Brevo.
BREVO_API_KEY=
BREVO_TEMPLATE_ID_INSCRIPCION=2
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=
